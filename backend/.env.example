# Servidor
PORT=8080
GIN_MODE=debug

# Modo Mock (Simulación sin requerir servidor de base de datos)
# true: Corre con datos mockeados en memoria (SQLite en memoria)
# false: Intenta conectar al servidor real PostgreSQL especificado abajo
MOCK_MODE=true

# Base de Datos (PostgreSQL)
DB_HOST=localhost
DB_USER=parker
DB_PASSWORD=parker123
DB_NAME=tech_fix
DB_PORT=5432
DB_SSLMODE=disable

# JWT (Opcional para futuro)
JWT_SECRET=tu_secreto_super_seguro

# Mercado Pago
MERCADO_PAGO_ACCESS_TOKEN=tu_token_de_acceso_mercado_pago
MERCADO_PAGO_WEBHOOK_SECRET=tu_webhook_secret_de_mercado_pago
NOTIFICATION_URL=http://localhost:8080
